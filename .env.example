POSTGRES_DB=algopeer
APP_ENV=development
POSTGRES_USER=algopeer
POSTGRES_PASSWORD=change-me-before-demo
DATABASE_URL=postgresql+psycopg://algopeer:change-me-before-demo@db:5432/algopeer
JWT_SECRET=replace-this-with-a-long-random-value
JWT_EXPIRE_MINUTES=480
# Internal HTTP endpoints fail closed until a separate service credential is set.
INTERNAL_API_TOKEN=
CORS_ORIGINS=http://localhost:5173
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/app/storage
JUDGE_QUEUE_NAME=algopeer:judge:queue
JUDGE_WORKER_CONCURRENCY=1
JUDGE_WORK_VOLUME=algopeer-judge-work
JUDGE_IMAGE=algopeer-judge-cpp:latest
JUDGE_SOURCE_LIMIT_BYTES=65536
JUDGE_TOTAL_TIME_LIMIT_MS=10000
JUDGE_OUTPUT_LIMIT_BYTES=1048576
JUDGE_COMPILER_OUTPUT_LIMIT_BYTES=4096

# Optional evidence-based video analysis. Keep the key server-side only.
AI_VIDEO_PROVIDER=
AI_VIDEO_API_KEY=
AI_VIDEO_BASE_URL=
AI_VIDEO_MODEL=
AI_VIDEO_ENABLED=false
